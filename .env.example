# Copy this file to `.env` and set production values. docker-compose uses `env_file: .env` so your .env will be loaded into containers.
# Example environment variables used by the project (see `core/config.py` for full list and defaults).
HOST=0.0.0.0
PORT=8000
DEBUG=false
# GROQ API key (leave blank if not using Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_RETRY_ATTEMPTS=2
LOG_LEVEL=info
MAX_FILE_SIZE=10485760

# Add any other environment variables you use locally here.
